{
  "name": "inno-fighters",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "InnoFighters - jogo de luta 2D (Canvas 2D, TypeScript estrito)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "orcamento": "node ferramentas/orcamento/cli.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:build": "playwright test -c playwright.build.config.ts",
    "sprites": "node ferramentas/sprites/cli.mjs",
    "balanco": "node ferramentas/balanco/cli.mjs",
    "sons:pacote-teste": "node ferramentas/sons/gerar-pacote-teste.mjs",
    "trailer:escalar": "node ferramentas/trailer/cli.mjs",
    "trailer:medir": "node ferramentas/trailer/medir.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
